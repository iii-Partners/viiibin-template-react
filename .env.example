# Application
VITE_APP_NAME=My App
VITE_APP_DESCRIPTION=Built with viiibin

# Auth0 (leave blank to disable auth)
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# API — backend URL for /api proxy (default: same origin)
VITE_API_BASE_URL=/api

# AI Chat Widget — set to "none" to disable, or "anthropic"/"openai"
VITE_AI_PROVIDER=none
VITE_AI_MODEL=claude-sonnet-4-20250514

# Analytics — fleet telemetry: PostHog on the iii Partners schema (README "Telemetry and delivery proof")
VITE_ENABLE_ANALYTICS=false
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_VENTURE_ID=
VITE_PILLAR=template
VITE_APP_ENV=

# Theme
VITE_PRIMARY_COLOR=#6366f1

# Push Notifications (Android only)
VITE_FCM_SENDER_ID=

# ---- Server side (Pages project variables and secrets, or .dev.vars for `wrangler pages dev`; see .dev.vars.example) ----
# POSTHOG_KEY, POSTHOG_HOST, VENTURE_ID, PILLAR, APP_ENV     fleet telemetry from the functions
# RESEND_API_KEY, NOTIFY_FROM                                the welcome email (POST /api/notify)
# TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM         the SMS code (POST /api/notify)
# API_KEYS, APP_NAME, APP_URL                                machine keys for /api, the app's name and public URL
# ---- Delivery tests only (never shipped): MAILOSAUR_API_KEY, MAILOSAUR_SERVER_ID, MAILOSAUR_PHONE_NUMBER, DELIVERY_API_KEY, DELIVERY_BASE_URL ----
