# Server-side variables for `wrangler pages dev` (copy to .dev.vars, which is gitignored). In production these are the
# Pages project's variables and secrets. Names only here; never commit values.
APP_NAME=My App
APP_URL=http://127.0.0.1:8788
# Machine keys accepted by functions/_middleware.ts (comma-separated vk_ keys)
API_KEYS=
# EYE-only KPI read grant: subset of API_KEYS. Empty keeps /api/kpis closed.
# Server secret only, never a VITE_* variable. Do not put real values in this example.
KPI_READ_API_KEYS=
# Fleet telemetry (functions/_lib/telemetry.ts): this app's PostHog project write key and identity on the fleet schema
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
VENTURE_ID=
PILLAR=template
APP_ENV=development
# Outbound messages (functions/api/notify.ts): email through Resend, SMS through Twilio
RESEND_API_KEY=
NOTIFY_FROM=My App <noreply@example.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
